{
  "crons": [
    {
      "path": "/api/sync-medium",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/media/:path*",
      "destination": "https://vieqhbbzndgyqwspgkmy.supabase.co/storage/v1/object/public/portfolio-media/:path*"
    },
    {
      "destination": "/api/$1",
      "source": "/api/(.*)"
    },
    {
      "source": "/casestudy/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*facebookexternalhit.*|.*Twitterbot.*|.*LinkedInBot.*|.*WhatsApp.*|.*TelegramBot.*|.*Slackbot.*|.*Discordbot.*|.*Pinterest.*)"
        }
      ],
      "destination": "/api/og?path=/casestudy/:slug"
    },
    {
      "source": "/writing/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*facebookexternalhit.*|.*Twitterbot.*|.*LinkedInBot.*|.*WhatsApp.*|.*TelegramBot.*|.*Slackbot.*|.*Discordbot.*|.*Pinterest.*)"
        }
      ],
      "destination": "/api/og?path=/writing/:slug"
    },
    {
      "destination": "/index.html",
      "source": "/(.*)"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": true,
      "*": false
    }
  }
}