# Bishal Mistri CMS - Environment Variables Template
# NEVER commit your real .env file or sensitive keys to Git!

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase Public Anonymous Key (safe for frontend client use with RLS)
# DO NOT USE 'service_role' key here!
VITE_SUPABASE_ANON_KEY=
